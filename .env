# ---------------------------------------------------------------------------
# Component versions
#
# These are the versions this demo has been run and verified against. Change a
# line, then re-run ./scripts/reset.sh to rebuild the whole estate on it.
#
# Both podman compose and docker compose read this file automatically.
# ---------------------------------------------------------------------------

# Keycloak. Any 26.x should work; Organizations must be present and enabled by
# default, which holds from 26.2 onward.
#   Tags: https://quay.io/repository/keycloak/keycloak?tab=tags
KEYCLOAK_VERSION=26.7.1

# lldap - the LDAP directory behind org-b. Tags are date-stamped rather than
# semver; this one is lldap 0.6.3. Avoid "latest" so the demo stays reproducible.
#   Tags: https://hub.docker.com/r/lldap/lldap/tags
LLDAP_VERSION=2026-08-10

# Node base image for the two sample applications.
NODE_VERSION=22-alpine

# ---------------------------------------------------------------------------
# To try the Red Hat build of Keycloak instead, set both of these and run
# `podman login registry.redhat.io` first:
#
#   KEYCLOAK_IMAGE=registry.redhat.io/rhbk/keycloak-rhel9
#   KEYCLOAK_VERSION=26.6
# ---------------------------------------------------------------------------
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak
